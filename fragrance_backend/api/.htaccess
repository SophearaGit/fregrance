# Send every /api/... request to index.php (needs Apache mod_rewrite, on by default in Laragon).
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Hand the login token (Authorization header) to PHP.
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [QSA,L]
</IfModule>
